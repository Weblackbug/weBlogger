{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "weBlogger",
  "mainBinaryName": "weblogger",
  "version": "1.2.0",
  "identifier": "com.weblackbug.weblogger",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "weBlogger",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "center": true,
        "decorations": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https: http:; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' data: blob: https:; frame-src 'self' blob: data: https:; connect-src 'self' blob: data: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "BitxoSOFT",
    "copyright": "BitxoSOFT (c) 2026 - WeBlackBug",
    "category": "Productivity",
    "shortDescription": "weBlogger - editor de blogs y periodicos",
    "longDescription": "weBlogger: editor visual de articulos de blog y de periodicos sobre el entorno n.k-7. Cada articulo se guarda en su carpeta con su HTML, CSS, JavaScript e imagenes. BitxoSOFT (c) 2026 - WeBlackBug, Granollers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "es-ES",
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "weblog"
        ],
        "name": "weBlogger.Publicacion",
        "description": "Publicación de weBlogger (periódico o revista)",
        "role": "Editor",
        "mimeType": "application/x-weblog"
      }
    ]
  }
}
